{
  "name": "camcord-debian",
  "productName": "CamCord",
  "version": "1.9.2",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "description": "CamCord screen and window recorder for Debian",
  "scripts": {
    "prepare:shared": "node scripts/prepare-shared.mjs",
    "pretest": "npm run prepare:shared && node scripts/check-python.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": { "@electron/packager": "20.3.0" },
  "overrides": { "@electron/asar": { "glob": "14.0.3", "minimatch": "11.0.3" } },
  "engines": { "node": ">=22.12.0" },
  "electronVersion": "44.7.0"
}
